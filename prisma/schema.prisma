generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ChangeType {
  SALES
  IMPORT
  ADJUSTMENT
  RETURN
}

enum VoucherType {
  FLAT
  PERCENT
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  active      Boolean  @default(true)
  description String?  @default("")
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users Profile[]

  @@map("roles")
}

model Profile {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String    @unique
  password  String
  roleCode  String    @default("USR")
  isOnline  Boolean   @default(false)
  dob       String?   @default("")
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  role Role @relation(fields: [roleCode], references: [code])

  @@map("profiles")
}

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  mainCategory String
  subCategory  String
  unit         String   @default("pcs")
  description  String?  @default("")
  price        Float
  importPrice  Float
  qty          Int      @default(0)
  sizes        Json     @default("[]")
  images       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skus     ProductSku[]
  vouchers VoucherProduct[]

  @@map("products")
}

model ProductSku {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  sku       String
  price     Float
  qty       Int
  images    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories Inventory[]

  @@map("product_skus")
}

model Inventory {
  id         String     @id @default(uuid()) @db.Uuid
  skuId      String     @db.Uuid
  changeType ChangeType
  qtyChange  Int
  refOrderId String?    @db.Uuid
  note       String?    @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  sku ProductSku @relation(fields: [skuId], references: [id])

  @@map("inventories")
}

model Voucher {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique
  active      Boolean     @default(true)
  description String?     @default("")
  type        VoucherType @default(FLAT)
  amount      Float
  max         Int         @default(0)
  startDate   String
  endDate     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  products VoucherProduct[]

  @@map("vouchers")
}

// Junction table cho quan hệ nhiều-nhiều Voucher <-> Product
model VoucherProduct {
  voucherId String @db.Uuid
  productId String @db.Uuid

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([voucherId, productId])
  @@map("voucher_products")
}
